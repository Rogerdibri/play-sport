{
  "expo": {
    "name": "PlaySport",
    "slug": "playsport",
    "version": "0.1.0",
    "orientation": "portrait",
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      ["expo-image-picker", {
        "photosPermission": "Permite elegir una foto para tu perfil de PlaySport.",
