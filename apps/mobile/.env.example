# Use the same web origin in the browser and the installed app.
EXPO_PUBLIC_PLAYSPORT_WEB_ORIGIN=http://localhost:3000
# Physical phones: replace localhost with the development computer's LAN address.
# Without an explicit origin, Expo Go uses its development host and port 3000.
# Legacy component tests only; the application calls the API through the web.
EXPO_PUBLIC_PLAYSPORT_API_BASE=http://localhost:4000/api
