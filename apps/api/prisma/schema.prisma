generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model League {
  id   String @id @default(cuid())
  name String
}

model Team {
  id   String @id @default(cuid())
  name String
}

model Player {
  id          String @id @default(cuid())
  displayName String
}

model Game {
  id        String   @id @default(cuid())
  startsAt  DateTime
  status    String   @default("scheduled")
}
