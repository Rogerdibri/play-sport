DATABASE_URL=postgresql://playsport:playsport@localhost:5432/playsport
JWT_SECRET=change-me
PLAYSPORT_WEB_ORIGIN=http://localhost:3000
# Explicit administrative account UUID; never grants sporting roles or identity-review permission.
# PLAYSPORT_ADMIN_ACCOUNT_ID=
# Separate account UUID authorized to review identity evidence.
# PLAYSPORT_IDENTITY_REVIEWER_ACCOUNT_ID=
# Optional explicit additional web origins, e.g. a development computer's LAN URL.
# PLAYSPORT_ADDITIONAL_WEB_ORIGINS=http://192.168.1.10:3000
